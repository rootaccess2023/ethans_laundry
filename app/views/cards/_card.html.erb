<div class="mx-auto max-w-[420px] overflow-hidden rounded-2xl border-[3px] border-navy bg-white font-sans shadow-[0_8px_24px_rgba(26,58,143,0.15)]">
  <div class="bg-navy px-4 pb-3.5 pt-5 text-center text-white">
    <h1 class="mb-1 text-[22px] font-bold tracking-wide">Ethan's Laundry Shop</h1>
    <p class="inline-block rounded-full bg-white px-2.5 py-0.5 text-[13px] font-bold text-brand-red">
      Wash 10 times, your 11th wash is FREE!
    </p>
  </div>

  <div class="p-5">
    <p class="mb-[18px] text-center text-lg font-bold text-navy"><%= customer.name %></p>

    <div class="mb-4 grid grid-cols-5 gap-2.5">
      <% (0...LoyaltyCard::STAMPS_REQUIRED).each do |i| %>
        <% stamped = i < card.stamps_count %>
        <div class="flex aspect-square items-center justify-center rounded-full border-2 text-base font-bold <%= stamped ? "border-navy bg-navy text-white" : "border-dashed border-navy text-navy" %>">
          <%= i + 1 %>
        </div>
      <% end %>
    </div>

    <div class="mb-4 rounded-xl border-[3px] border-brand-red px-3.5 py-3.5 text-center font-bold tracking-widest <%= card.reward_ready? ? "bg-brand-red text-white" : "text-brand-red" %>">
      FREE
    </div>

    <% if card.reward_ready? %>
      <p class="mb-1 text-center text-[15px] font-bold text-navy">🎁 Your 11th wash is FREE — show this to the staff</p>
    <% else %>
      <p class="mb-1 text-center text-[15px] font-bold text-navy"><%= LoyaltyCard::STAMPS_REQUIRED - card.stamps_count %> more to go</p>
    <% end %>
  </div>

  <div class="bg-gray-100 px-3 py-3 text-center text-[13px] font-bold text-navy">
    Full cards completed: <%= customer.completed_cards_count %> 🎉
  </div>
</div>
