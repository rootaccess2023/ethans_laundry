<div class="min-h-screen bg-gray-50 font-sans text-gray-900">
  <input type="radio" name="tab" id="tab-home" class="hidden" <%= "checked" unless @query.present? %>>
  <input type="radio" name="tab" id="tab-loyalty-card" class="hidden" <%= "checked" if @query.present? %>>

  <header class="site-header sticky top-0 z-10 border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-6 py-4">
      <div class="flex items-center gap-2 text-lg font-extrabold text-navy">
        <span class="text-2xl">🧺</span> Ethan's Laundry Shop
      </div>
      <div class="flex gap-1 rounded-full border border-gray-200 bg-gray-50 p-1">
        <label for="tab-home" class="cursor-pointer rounded-full px-4 py-2 text-sm font-semibold text-gray-500 transition-colors">Home</label>
        <label for="tab-loyalty-card" class="cursor-pointer rounded-full px-4 py-2 text-sm font-semibold text-gray-500 transition-colors">Loyalty Card</label>
      </div>
    </div>
  </header>

  <div class="home-panel hidden">
    <section class="bg-gradient-to-br from-navy to-navy-dark px-6 py-16 text-center text-white sm:py-20">
      <span class="mb-5 inline-block rounded-full bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-white">
        Loyalty Program
      </span>
      <h1 class="mx-auto max-w-2xl text-4xl font-extrabold leading-tight sm:text-5xl">
        Wash 10 times.<br>Your 11th wash is FREE.
      </h1>
      <p class="mx-auto mt-4 max-w-md text-base text-white/85">
        Every drop-off earns a stamp on your personal loyalty card. Fill it up and your next wash is on us.
      </p>
      <label for="tab-loyalty-card" class="mt-8 inline-block cursor-pointer rounded-lg bg-brand-red px-8 py-3.5 text-sm font-bold text-white hover:bg-brand-red/90">
        Find My Loyalty Card
      </label>
    </section>

    <section class="px-6 py-16">
      <h2 class="text-center text-2xl font-bold sm:text-3xl">How it works</h2>
      <p class="mx-auto mt-2 max-w-md text-center text-gray-500">No app to install, no card to lose — just your name.</p>

      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-50 text-3xl">🧺</div>
          <h3 class="mb-2 font-bold">1. Drop off a wash</h3>
          <p class="text-sm text-gray-500">Bring your laundry in as usual — nothing changes about how you wash with us.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-50 text-3xl">✅</div>
          <h3 class="mb-2 font-bold">2. Get stamped</h3>
          <p class="text-sm text-gray-500">Our staff add a stamp to your loyalty card every time you check out.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-50 text-3xl">🎁</div>
          <h3 class="mb-2 font-bold">3. 11th wash is free</h3>
          <p class="text-sm text-gray-500">Collect 10 stamps and your next wash costs nothing.</p>
        </div>
      </div>
    </section>

    <div class="mx-auto mb-16 max-w-3xl rounded-2xl border border-gray-200 bg-white p-9 text-center">
      <h2 class="mb-2 text-xl font-bold">Already a customer?</h2>
      <p class="mb-5 text-gray-500">Search your name to see your card and how close you are to a free wash.</p>
      <label for="tab-loyalty-card" class="inline-block cursor-pointer rounded-lg bg-brand-red px-8 py-3.5 text-sm font-bold text-white hover:bg-brand-red/90">
        Check My Progress
      </label>
    </div>
  </div>

  <div class="loyalty-card-panel hidden">
    <section class="px-6 py-14">
      <div class="mx-auto max-w-[520px] rounded-2xl border border-gray-200 bg-white p-9">
        <h1 class="text-center text-2xl font-bold">Find Your Loyalty Card</h1>
        <p class="mt-2 text-center text-gray-500">Search your name to find your card and check your stamp progress.</p>

        <%= form_with url: root_path, method: :get, local: true, class: "mt-6 flex gap-2" do %>
          <%= text_field_tag :name, @query, placeholder: "Enter your name", class: "min-w-0 flex-1 rounded-lg border border-gray-200 px-3.5 py-3 text-[15px] focus:outline focus:outline-2 focus:outline-navy" %>
          <%= submit_tag "Search", class: "cursor-pointer rounded-lg bg-brand-red px-5 py-3 text-[15px] font-bold text-white hover:bg-brand-red/90" %>
        <% end %>

        <% if @query.present? %>
          <% if @results.any? %>
            <ul class="mt-5 space-y-2">
              <% @results.each do |customer| %>
                <li>
                  <%= link_to public_card_path(customer.public_token), class: "flex items-center justify-between rounded-lg bg-gray-50 px-4 py-3.5 font-bold text-navy hover:bg-gray-100" do %>
                    <%= customer.name %>
                    <span aria-hidden="true">→</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-5 text-center text-sm text-gray-500">No customer found named "<%= @query %>". Please check with staff.</p>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>

  <footer class="border-t border-gray-200 px-6 py-7 text-center text-sm text-gray-500">
    Ethan's Laundry Shop &middot; Ask any staff member for help finding your card.
  </footer>
</div>
