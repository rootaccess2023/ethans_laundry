<div class="min-h-screen bg-gray-50 font-sans text-gray-900">
  <input type="radio" name="tab" id="tab-home" class="hidden" <%= "checked" unless @query.present? %>>
  <input type="radio" name="tab" id="tab-loyalty-card" class="hidden" <%= "checked" if @query.present? %>>

  <header class="site-header sticky top-0 z-10 border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-6 py-4">
      <div class="flex items-center gap-2 font-heading text-lg font-extrabold text-navy">
        <span class="text-2xl">🧺</span> Ethan's Laundry Shop
      </div>
      <div class="flex gap-1 rounded-full border border-gray-200 bg-gray-50 p-1">
        <label for="tab-home" class="cursor-pointer rounded-full px-4 py-2 text-sm font-semibold text-gray-500 transition-colors">Home</label>
        <label for="tab-loyalty-card" class="cursor-pointer rounded-full px-4 py-2 text-sm font-semibold text-gray-500 transition-colors">Loyalty Card</label>
      </div>
    </div>
  </header>

  <div class="home-panel hidden">
    <section class="bg-gradient-to-br from-navy to-navy-dark px-6 py-16 text-center text-white sm:py-20">
      <span class="mb-5 inline-block rounded-full bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-white">
        Loyalty Program
      </span>
      <h1 class="mx-auto max-w-2xl font-heading text-4xl font-extrabold leading-tight sm:text-5xl">
        Wash 10 times.<br>Your 11th wash is FREE.
      </h1>
      <p class="mx-auto mt-4 max-w-md text-base text-white/85">
        Every drop-off earns a stamp on your personal loyalty card. Fill it up and your next wash is on us.
      </p>
      <label for="tab-loyalty-card" class="mt-8 inline-block cursor-pointer rounded-lg bg-brand-red px-8 py-3.5 text-sm font-bold text-white hover:bg-brand-red/90">
        Find My Loyalty Card
      </label>
    </section>

    <section class="px-6 py-16">
      <h2 class="font-heading text-center text-2xl font-bold sm:text-3xl">How it works</h2>
      <p class="mx-auto mt-2 max-w-md text-center text-gray-500">No app to install, no card to lose — just your name.</p>

      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-50 text-3xl">🧺</div>
          <h3 class="mb-2 font-heading font-bold">1. Drop off a wash</h3>
          <p class="text-sm text-gray-500">Bring your laundry in as usual — nothing changes about how you wash with us.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-50 text-3xl">✅</div>
          <h3 class="mb-2 font-heading font-bold">2. Get stamped</h3>
          <p class="text-sm text-gray-500">Our staff add a stamp to your loyalty card every time you check out.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-50 text-3xl">🎁</div>
          <h3 class="mb-2 font-heading font-bold">3. 11th wash is free</h3>
          <p class="text-sm text-gray-500">Collect 10 stamps and your next wash costs nothing.</p>
        </div>
      </div>
    </section>

    <section class="bg-gradient-to-br from-navy to-navy-dark px-6 py-16 text-center text-white">
      <span class="mb-5 inline-block rounded-full bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-white">
        LG BLACK Label
      </span>
      <h2 class="mx-auto max-w-2xl font-heading text-2xl font-bold sm:text-3xl">Cleaned with LG BLACK Label Equipment</h2>
      <p class="mx-auto mt-4 max-w-md text-base text-white/85">
        We wash and dry every load on LG's commercial-grade BLACK Label washers and dryers — trusted for powerful, fabric-safe cleaning on every cycle.
      </p>

      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-3">
        <div class="rounded-2xl bg-white/10 p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/10 text-3xl">💧</div>
          <h3 class="mb-2 font-heading font-bold">Deep Clean Technology</h3>
          <p class="text-sm text-white/85">TurboWash cycles lift out dirt and stains without harming fabric.</p>
        </div>
        <div class="rounded-2xl bg-white/10 p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/10 text-3xl">🌀</div>
          <h3 class="mb-2 font-heading font-bold">Gentle Fabric Care</h3>
          <p class="text-sm text-white/85">Precise drum motion keeps clothes looking newer, longer.</p>
        </div>
        <div class="rounded-2xl bg-white/10 p-7 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/10 text-3xl">⚡</div>
          <h3 class="mb-2 font-heading font-bold">Energy Efficient</h3>
          <p class="text-sm text-white/85">Commercial-grade efficiency means faster turnaround for your laundry.</p>
        </div>
      </div>
    </section>

    <section class="bg-white px-6 py-16">
      <h2 class="font-heading text-center text-2xl font-bold sm:text-3xl">Hours &amp; Pricing</h2>
      <p class="mx-auto mt-2 flex max-w-md items-center justify-center gap-2 text-center text-gray-500">
        <span aria-hidden="true">🕐</span> Open every day, 7:00 AM – 7:00 PM
      </p>
      <p class="mx-auto mt-3 text-center text-sm font-semibold uppercase tracking-wide text-navy">
        Full Service — Wash • Dry • Fold
      </p>

      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
          <h3 class="font-heading font-bold">Regular Clothes</h3>
          <p class="mt-1 text-xl font-extrabold text-navy">₱190 <span class="text-sm font-semibold text-gray-500">/ load</span></p>
          <p class="mt-1 text-sm font-medium text-navy/70">Up to 8 kg</p>
          <p class="mt-2 text-sm text-gray-500">T-shirts, polo shirts, blouses, dresses, shorts, skirts, pajamas, undergarments, socks, baby clothes, and other light clothing.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
          <h3 class="font-heading font-bold">Heavy Fabrics</h3>
          <p class="mt-1 text-xl font-extrabold text-navy">₱190 <span class="text-sm font-semibold text-gray-500">/ load</span></p>
          <p class="mt-1 text-sm font-medium text-navy/70">Up to 5 kg</p>
          <p class="mt-2 text-sm text-gray-500">Jeans (maong), towels, bed sheets, blankets, jackets, curtains, and other thick fabrics.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
          <h3 class="font-heading font-bold">Bulky Items</h3>
          <p class="mt-1 text-xl font-extrabold text-navy">₱190 <span class="text-sm font-semibold text-gray-500">/ load</span></p>
          <ul class="mt-2 space-y-1 text-sm text-gray-500">
            <li>Single comforter: 1–3 pieces</li>
            <li>Double comforter: 1–2 pieces</li>
            <li>Queen comforter: 1 piece</li>
          </ul>
          <p class="mt-2 text-xs text-gray-400">Capacity may vary with size and thickness.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
          <h3 class="font-heading font-bold">Excess Load</h3>
          <p class="mt-1 text-xl font-extrabold text-navy">₱25 <span class="text-sm font-semibold text-gray-500">/ additional kg</span></p>
          <p class="mt-2 text-sm text-gray-500">Maximum of 3 kg excess per load. If your laundry exceeds the limit, we recommend adding another load for the best wash.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
          <h3 class="font-heading font-bold">Other Services</h3>
          <dl class="mt-3 space-y-1.5 text-sm">
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Additional Detergent</dt><dd class="font-semibold text-navy">₱15</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Additional Fabric Conditioner</dt><dd class="font-semibold text-navy">₱15</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Additional Zonrox Bleach</dt><dd class="font-semibold text-navy">₱15</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Additional Rinse</dt><dd class="font-semibold text-navy">₱20</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Wash Only</dt><dd class="font-semibold text-navy">₱90</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Dry Only</dt><dd class="font-semibold text-navy">₱90</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Fold Only</dt><dd class="font-semibold text-navy">₱30</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500">Wash &amp; Dry</dt><dd class="font-semibold text-navy">₱160</dd></div>
          </dl>
        </div>
        <div class="rounded-2xl border-[3px] border-brand-red bg-white p-7">
          <h3 class="font-heading font-bold text-brand-red">White Clothes Special</h3>
          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-brand-red/80">Overnight Soaking (Babaan)</p>
          <p class="mt-1 text-xl font-extrabold text-brand-red">₱190 <span class="text-sm font-semibold text-gray-500">/ load</span></p>
          <p class="mt-1 text-sm font-medium text-navy/70">Up to 6 kg</p>
          <p class="mt-2 text-sm text-gray-500">White uniforms, white shirts, school uniforms, white linens, and clothes with stubborn stains.</p>
        </div>
      </div>
    </section>

    <div class="mx-auto mb-16 max-w-3xl rounded-2xl border border-gray-200 bg-white p-9 text-center">
      <h2 class="mb-2 font-heading text-xl font-bold">Already a customer?</h2>
      <p class="mb-5 text-gray-500">Search your name to see your card and how close you are to a free wash.</p>
      <label for="tab-loyalty-card" class="inline-block cursor-pointer rounded-lg bg-brand-red px-8 py-3.5 text-sm font-bold text-white hover:bg-brand-red/90">
        Check My Progress
      </label>
    </div>
  </div>

  <div class="loyalty-card-panel hidden">
    <section class="px-6 py-14">
      <div class="mx-auto max-w-[520px] rounded-2xl border border-gray-200 bg-white p-9">
        <h1 class="font-heading text-center text-2xl font-bold">Find Your Loyalty Card</h1>
        <p class="mt-2 text-center text-gray-500">Search your name to find your card and check your stamp progress.</p>

        <%= form_with url: root_path, method: :get, local: true, class: "mt-6 flex gap-2" do %>
          <%= text_field_tag :name, @query, placeholder: "Enter your name", class: "min-w-0 flex-1 rounded-lg border border-gray-200 px-3.5 py-3 text-[15px] focus:outline focus:outline-2 focus:outline-navy" %>
          <%= submit_tag "Search", class: "cursor-pointer rounded-lg bg-brand-red px-5 py-3 text-[15px] font-bold text-white hover:bg-brand-red/90" %>
        <% end %>

        <% if @query.present? %>
          <% if @results.any? %>
            <ul class="mt-5 space-y-2">
              <% @results.each do |customer| %>
                <li>
                  <%= link_to public_card_path(customer.public_token), class: "flex items-center justify-between rounded-lg bg-gray-50 px-4 py-3.5 font-bold text-navy hover:bg-gray-100" do %>
                    <%= customer.name %>
                    <span aria-hidden="true">→</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-5 text-center text-sm text-gray-500">No customer found named "<%= @query %>". Please check with staff.</p>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>

  <footer class="border-t border-gray-200 px-6 py-7 text-center text-sm text-gray-500">
    Ethan's Laundry Shop &middot; Ask any staff member for help finding your card.
  </footer>
</div>
